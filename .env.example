# Copy this file to `.env` and fill in your own OAuth credentials.
#
# Only needed when building from source. The released binaries ship with
# credentials configured -- see https://github.com/wslyvh/paperweight/releases
#
# Full setup instructions: see "Development" in README.md

# Google / Gmail -- https://console.cloud.google.com/
# OAuth 2.0 credentials, application type "Desktop app".
# Enable the Gmail API and add the scope:
#   https://www.googleapis.com/auth/gmail.modify
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft -- https://portal.azure.com/
# App registration, platform "Mobile and desktop applications".
# No secret needed: the Microsoft flow uses PKCE.
MICROSOFT_CLIENT_ID=
