{
  "include": [
    "electron.vite.config.mts",
    "src/mcp/**/*",
    "src/main/**/*",
    "src/shared/**/*",
    "src/preload/**/*",
    "analysis/src/**/*"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "outDir": "./out",
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ],
      "@paperweight/analysis": [
        "./analysis/src/index"
      ],
      "@paperweight/analysis/contracts": [
        "./analysis/src/contracts"
      ],
      "@paperweight/analysis/country": [
        "./analysis/src/country"
      ],
      "@paperweight/analysis/received-address": [
        "./analysis/src/received-address"
      ],
      "@paperweight/analysis/profile-values": [
        "./analysis/src/profile-values"
      ]
    },
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ESNext",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "jsx": "react-jsx"
  }
}
