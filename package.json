{
  "name": "paperweight",
  "version": "1.2.1",
  "description": "Manage your digital footprint",
  "license": "MIT",
  "author": "wslyvh",
  "main": "./out/main/index.js",
  "desktopName": "email.paperweight.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:local": "tsx scripts/dev-local.ts",
    "prebuild": "yarn build:companies && yarn build:breaches",
    "build": "electron-vite build",
    "mcp": "cross-env PAPERWEIGHT_MCP=1 electron .",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "yarn typecheck:node && yarn typecheck:web && tsc --noEmit -p tsconfig.test.json",
    "build:companies": "tsx scripts/build-companies-db.ts",
    "build:breaches": "tsx scripts/build-breaches-db.ts",
    "dist": "yarn dist:mac && yarn dist:linux && yarn dist:win",
    "dist:mac": "yarn build && electron-builder --mac --publish never && node scripts/set-mac-update-minimum.cjs",
    "dist:linux": "yarn build && electron-builder --linux --publish never",
    "dist:win": "yarn build && electron-builder --win --publish never",
    "seed:test-account": "cross-env TSX_TSCONFIG_PATH=tsconfig.node.json electron scripts/seed-test-account.cjs",
    "test": "vitest run",
    "test:mcp": "electron-vite build && tsx scripts/smoke-mcp.ts",
    "fixture:regenerate": "yarn build:companies && yarn build:breaches && cross-env TSX_TSCONFIG_PATH=tsconfig.node.json ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/generate-smoke-fixture.ts test/fixtures/smoke-account --replace",
    "test:smoke": "yarn build && tsx scripts/smoke-desktop.ts",
    "test:analysis": "yarn --cwd analysis test",
    "test:all": "yarn test && yarn test:analysis && yarn test:smoke && yarn test:mcp",
    "scripts:stats": "tsx scripts/release-stats.ts",
    "build:breach": "cross-env TSX_TSCONFIG_PATH=tsconfig.node.json ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/generate-breach-content.ts",
    "build:enforcement": "cross-env TSX_TSCONFIG_PATH=tsconfig.node.json ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/build-enforcement-db.ts"
  },
  "build": {
    "appId": "email.paperweight",
    "productName": "Paperweight",
    "artifactName": "Paperweight-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!node_modules/**/{test,tests,__tests__,fixtures}/**",
      "!node_modules/**/*.{test,spec}.{js,cjs,mjs,ts,tsx}"
    ],
    "extraResources": [
      {
        "from": "resources/companies.db",
        "to": "companies.db"
      },
      {
        "from": "resources/breaches.db",
        "to": "breaches.db"
      },
      {
        "from": "build/mcp/paperweight-mcp",
        "to": "paperweight-mcp"
      },
      {
        "from": "build/mcp/paperweight-mcp.cmd",
        "to": "paperweight-mcp.cmd"
      },
      {
        "from": "build/mcp/windows-stdio.cjs",
        "to": "windows-stdio.cjs"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "x64ArchFiles": "Contents/Resources/app.asar.unpacked/node_modules/better-sqlite3-multiple-ciphers/prebuilds/darwin-{x64,arm64}.node",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "wslyvh",
      "icon": "build/icon.png"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true
    },
    "publish": {
      "provider": "github",
      "owner": "wslyvh",
      "repo": "paperweight"
    },
    "npmRebuild": false
  },
  "dependencies": {
    "@electron-toolkit/utils": "4.0.0",
    "@modelcontextprotocol/server": "2.4.0",
    "better-sqlite3-multiple-ciphers": "13.2.0",
    "dayjs": "1.11.23",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.11",
    "ethereum-blockies-base64": "1.0.2",
    "imapflow": "2.12.1",
    "lucide-react": "1.75.0",
    "mailparser": "3.14.5",
    "nodemailer": "10.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "react-router": "7.18.5",
    "recharts": "3.11.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "better-sqlite3": "13.2.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "cross-env": "10.1.0",
    "daisyui": "5.8.1",
    "electron": "45.3.4",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "playwright-core": "1.65.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": "24.x"
  }
}